# Copy to .env and fill in. Never commit .env.
# Every variable is read and validated in src/config/env.ts.

# --- Database -----------------------------------------------------------------
# Local: `pnpm db:start` (scripts/dev-db.sh, port 54329) or `docker compose up -d db`.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/studio_dev

# --- App ------------------------------------------------------------------------
# Public base URL; used to build client magic links (https in production).
APP_BASE_URL=http://localhost:3000
# Server secret (>= 32 chars) for OTP hashing and download grants.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Business time zone: document numbering year, dates on PDFs, "today" dashboard.
BUSINESS_TIMEZONE=Europe/Istanbul

# --- Sales kill switch -----------------------------------------------------------
# Keep false until the work permit is issued (rule E3). While false: no payment
# links or pay buttons, quotes are view-only, no payment can be recorded.
# Only the value "true" enables sales.
SALES_ENABLED=false

# --- Admin (single user) ---------------------------------------------------------
ADMIN_EMAIL=founder@example.com
# argon2id hash, generate with `pnpm hash-password` (keeps the \$ escaping that
# Next.js needs; an unescaped hash gets mangled when .env is loaded).
ADMIN_PASSWORD_HASH=

# --- Email -------------------------------------------------------------------------
# Resend HTTP API key. Empty in development: emails are printed to the console and
# stored in the dev outbox table. Required in production.
RESEND_API_KEY=
# Sender, e.g. "Studio <no-reply@yourdomain.com>" (domain verified in Resend).
EMAIL_FROM=
# Where admin notifications go (optional).
ADMIN_NOTIFY_EMAIL=

# --- Files and PDFs ------------------------------------------------------------------
# Local storage for PDFs, payment evidence and deliverables (gitignored).
STORAGE_DIR=./storage
# Chromium binary used by playwright-core to render PDFs (never downloaded by the app).
# Cloud container: /opt/pw-browsers/chromium-1194/chrome-linux/chrome
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux example: /usr/bin/chromium
CHROMIUM_PATH=

# --- Client magic links ----------------------------------------------------------------
MAGIC_LINK_TTL_DAYS=90
